-- Demo-only state. Restarting the script resets it.
local used = 0
local cooldownUntil = 0
local characterName = ""
local amount = 0
local busy = false

local showKeyPage
local showNamePage
local showAmountPage
local showLoadingPage
local showResultPage
local showCooldownPage

showKeyPage = function()
    clearPage()
    heading("Enter Key")

    local box = inputBox("Enter access key", 70)
    local status = message("", C.red, 115)

    local nextBtn = button(
        page, "CONTINUE",
        UDim2.new(0, 25, 0, 166),
        UDim2.new(1, -50, 0, 36)
    )

    nextBtn.MouseButton1Click:Connect(function()
        if box.Text == KEY then
            showNamePage()
        else
            status.Text = "Invalid key."
        end
    end)
end

showNamePage = function()
    clearPage()
    heading("Character Name")

    local box = inputBox("Enter exact character name", 70)
    local status = message("", C.red, 115)

    local nextBtn = button(
        page, "CONTINUE",
        UDim2.new(0, 25, 0, 166),
        UDim2.new(1, -50, 0, 36)
    )

    nextBtn.MouseButton1Click:Connect(function()
        local name = box.Text

        -- Exact match: no automatic capitalization or trimming.
        if PREMIUM_UNITS[name] then
            status.Text = "Premium Required!"
            return
        end

        if not FREE_UNITS[name] then
            status.Text = "Invalid name. Check exact spelling."
            return
        end

        characterName = name
        showAmountPage()
    end)
end

showAmountPage = function()
    clearPage()
    heading("Unit Amount")

    local box = inputBox("Enter amount", 60)
    box.Text = "1"

    message(
        "Free unit cannot exceed Mythic rarity.",
        C.gray, 102
    )

    message(
        string.format("Units Used: %d/%d", used, MAX_UNITS),
        C.white, 125
    )

    local status = message("", C.red, 150)

    local confirm = button(
        page, "CONFIRM",
        UDim2.new(0, 25, 0, 192),
        UDim2.new(1, -50, 0, 36)
    )

    confirm.MouseButton1Click:Connect(function()
        if busy then return end

        if os.time() < cooldownUntil then
            showCooldownPage()
            return
        end

        if not box.Text:match("^%d+$") then
            status.Text = "Enter a whole number."
            return
        end

        local n = tonumber(box.Text)

        if FIVE_COST_UNITS[characterName] and n ~= 1 then
            status.Text = "Max 1 allowed for this unit."
            return
        end

        if n < 1 or n > MAX_UNITS then
            status.Text = "Maximum quantity is 10."
            return
        end

        local cost = FIVE_COST_UNITS[characterName] and 5 or 1
        local totalCost = cost * n

        if used + totalCost > MAX_UNITS then
            status.Text = string.format(
                "Not enough units remaining. Cost: %d.",
                totalCost
            )
            return
        end

        amount = n
        showLoadingPage()
    end)
end

showLoadingPage = function()
    clearPage()
    heading("Processing...")

    message("Character: " .. characterName, C.white, 70)

    local timer = message("Please wait 5 seconds...", C.purple, 110)

    busy = true

    task.spawn(function()
        for seconds = 5, 1, -1 do
            if not gui.Parent then return end
            timer.Text = "Please wait " .. seconds .. " seconds..."
            task.wait(1)
        end

        if not gui.Parent then return end

        local cost = FIVE_COST_UNITS[characterName] and 5 or 1
        used += cost * amount

        if used >= MAX_UNITS then
            cooldownUntil = os.time() + COOLDOWN
        end

        busy = false
        showResultPage()
    end)
end

showResultPage = function()
    clearPage()
    heading("Successfully Processed!")

    message("Character: " .. characterName, C.white, 60)
    message("Amount: " .. amount, C.white, 90)
    message(
        string.format("Units Used: %d/%d", used, MAX_UNITS),
        C.green, 120
    )

    local ok = button(
        page, "OK",
        UDim2.new(0, 25, 0, 178),
        UDim2.new(1, -50, 0, 36)
    )

    ok.MouseButton1Click:Connect(function()
        if used >= MAX_UNITS then
            showCooldownPage()
        else
            showNamePage()
        end
    end)
end

local function formatTime(seconds)
    seconds = math.max(0, seconds)

    return string.format(
        "%02d:%02d:%02d",
        math.floor(seconds / 3600),
        math.floor((seconds % 3600) / 60),
        seconds % 60
    )
end

showCooldownPage = function()
    clearPage()
    heading("Daily Limit Reached")

    local timer = message(
        "Cooldown: " .. formatTime(cooldownUntil - os.time()),
        C.purple, 80
    )

    message("Please come back later.", C.gray, 120)

    task.spawn(function()
        while gui.Parent and os.time() < cooldownUntil do
            timer.Text = "Cooldown: " ..
                formatTime(cooldownUntil - os.time())
            task.wait(1)
        end

        if gui.Parent and cooldownUntil > 0
            and os.time() >= cooldownUntil then
            used = 0
            cooldownUntil = 0
            showKeyPage()
        end
    end)
end

showKeyPage()
